rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: reviews
    // Document ID: Auto-generated by Firestore
    // Fields:
    //   - name: string (required, 2-80 chars) - Public display name.
    //   - message: string (required, 10-500 chars) - Public review text.
    //   - rating: integer (required, 1-5) - Customer star rating.
    //   - permission: bool (required, must be true) - Consent to publish.
    //   - createdAt: timestamp (required, immutable by no-update policy) - Server timestamp.
    //
    // Reviews are intentionally public because the website displays them on a
    // public feedback wall. Anonymous visitors may create, but not edit/delete,
    // tightly validated review documents.
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isRecentTimestamp(value) {
      return value is timestamp && value == request.time;
    }

    function isValidReview(data) {
      return hasOnlyAllowedFields(['name', 'message', 'rating', 'permission', 'createdAt']) &&
        hasRequiredFields(['name', 'message', 'rating', 'permission', 'createdAt']) &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 80 &&
        data.message is string &&
        data.message.size() >= 10 &&
        data.message.size() <= 500 &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.permission is bool &&
        data.permission == true &&
        isRecentTimestamp(data.createdAt);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
